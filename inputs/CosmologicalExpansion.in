# Cosmological Expansion simulation parameters
geometry.prob_lo     =  0.0  0.0  0.0 
geometry.prob_hi     =  1.0e24  1.0e24  1.0e24
geometry.is_periodic = 1 1 1

amr.n_cell          = 16 16 16
amr.max_level       = 0
amr.blocking_factor = 8

quokka.bc = periodic periodic periodic

# Cosmology
cosmology.hubble_constant = 0.7
cosmology.omega_m = 1.0
cosmology.omega_lambda = 0.0
cosmology.a_init = 1.0


# Simulation control
plotfile_interval = 50          # interval between plotfiles: save a plotfile every 100 timesteps
amr.v = 1                       # verbosity level: 0=quiet, 1=verbose, 2=very verbose

